{
  "export": [
    {
      "name": "agent-evaluation.slo.yaml",
      "hub": {
        "apiVersion": "nines.dev/v1alpha1",
        "kind": "ServiceLevelObjective",
        "metadata": {
          "name": "agent-evaluation-pass",
          "project": "production"
        },
        "spec": {
          "lifecycle": "experimental",
          "measurement": {
            "type": "availability",
            "metric": "agent_evaluations_total",
            "labels": {
              "service": "agent"
            },
            "successLabels": {
              "verdict": "pass"
            },
            "countFrom": "counter",
            "scrapeIntervalSeconds": 15,
            "observationPoint": "All tasks selected for the declared evaluation cohort with terminal verdicts. Pin rubric, evaluator and sampling policy using bounded labels. Failed and unevaluable verdicts stay in the denominator. Track evaluation completion coverage separately."
          },
          "source": "primary",
          "displayName": "Agent outcome evaluation",
          "service": "agent",
          "target": 0.99,
          "windowSeconds": 2419200,
          "stepSeconds": 60
        }
      },
      "beta": {
        "apiVersion": "nines.dev/v1beta1",
        "kind": "ServiceLevelObjective",
        "metadata": {
          "name": "agent-evaluation-pass",
          "project": "production"
        },
        "spec": {
          "displayName": "Agent outcome evaluation",
          "service": "agent",
          "target": 0.99,
          "window": "28d",
          "step": "1m",
          "connection": "primary",
          "lifecycle": "experimental",
          "measurement": {
            "type": "availability",
            "metric": "agent_evaluations_total",
            "labels": {
              "service": "agent"
            },
            "successLabels": {
              "verdict": "pass"
            },
            "countFrom": "counter",
            "observationPoint": "All tasks selected for the declared evaluation cohort with terminal verdicts. Pin rubric, evaluator and sampling policy using bounded labels. Failed and unevaluable verdicts stay in the denominator. Track evaluation completion coverage separately."
          },
          "policies": []
        }
      }
    },
    {
      "name": "api-availability.slo.yaml",
      "hub": {
        "apiVersion": "nines.dev/v1alpha1",
        "kind": "ServiceLevelObjective",
        "metadata": {
          "name": "api-availability",
          "project": "production"
        },
        "spec": {
          "displayName": "API availability",
          "service": "gateway",
          "target": 0.999,
          "windowSeconds": 86400,
          "stepSeconds": 60,
          "goodQuery": "sum(increase(http_requests_total{code!~\"5..\"}[1m]))",
          "totalQuery": "sum(increase(http_requests_total[1m]))",
          "policies": [
            {
              "name": "fast-burn",
              "severity": "critical",
              "shortWindowSeconds": 300,
              "longWindowSeconds": 3600,
              "burnRate": 14.4,
              "forSeconds": 120,
              "minCoverage": 1
            },
            {
              "name": "sustained-burn",
              "severity": "warning",
              "shortWindowSeconds": 1800,
              "longWindowSeconds": 21600,
              "burnRate": 6,
              "forSeconds": 300,
              "minCoverage": 1
            }
          ]
        }
      },
      "beta": {
        "apiVersion": "nines.dev/v1beta1",
        "kind": "ServiceLevelObjective",
        "metadata": {
          "name": "api-availability",
          "project": "production"
        },
        "spec": {
          "displayName": "API availability",
          "service": "gateway",
          "target": 0.999,
          "window": "1d",
          "step": "1m",
          "queries": {
            "good": "sum(increase(http_requests_total{code!~\"5..\"}[1m]))",
            "total": "sum(increase(http_requests_total[1m]))"
          },
          "policies": [
            {
              "name": "fast-burn",
              "severity": "critical",
              "shortWindow": "5m",
              "longWindow": "1h",
              "burnRate": 14.4,
              "for": "2m"
            },
            {
              "name": "sustained-burn",
              "severity": "warning",
              "shortWindow": "30m",
              "longWindow": "6h",
              "burnRate": 6,
              "for": "5m"
            }
          ]
        }
      }
    },
    {
      "name": "inference-ttft.slo.yaml",
      "hub": {
        "apiVersion": "nines.dev/v1alpha1",
        "kind": "ServiceLevelObjective",
        "metadata": {
          "name": "inference-ttft",
          "project": "production"
        },
        "spec": {
          "lifecycle": "experimental",
          "measurement": {
            "type": "latency",
            "metric": "inference_time_to_first_token_seconds",
            "labels": {
              "service": "inference"
            },
            "thresholdSeconds": 0.5,
            "scrapeIntervalSeconds": 15,
            "observationPoint": "Streams reaching a first token only. Failed or never-started streams are excluded; pair with inference availability. This is a conditional latency SLO.. Requires a classic histogram in seconds with an exact matching le bucket and count series; summaries and percentile gauges are unsupported."
          },
          "source": "primary",
          "displayName": "Time to first token",
          "service": "inference",
          "target": 0.99,
          "windowSeconds": 2419200,
          "stepSeconds": 60
        }
      },
      "beta": {
        "apiVersion": "nines.dev/v1beta1",
        "kind": "ServiceLevelObjective",
        "metadata": {
          "name": "inference-ttft",
          "project": "production"
        },
        "spec": {
          "displayName": "Time to first token",
          "service": "inference",
          "target": 0.99,
          "window": "28d",
          "step": "1m",
          "connection": "primary",
          "lifecycle": "experimental",
          "measurement": {
            "type": "latency",
            "metric": "inference_time_to_first_token_seconds",
            "labels": {
              "service": "inference"
            },
            "threshold": "500ms",
            "observationPoint": "Streams reaching a first token only. Failed or never-started streams are excluded; pair with inference availability. This is a conditional latency SLO.. Requires a classic histogram in seconds with an exact matching le bucket and count series; summaries and percentile gauges are unsupported."
          },
          "policies": []
        }
      }
    },
