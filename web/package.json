{
  "name": "journey-reliability-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "format": "prettier --write src vite.config.ts tsconfig.json components.json index.html",
    "format:check": "prettier --check src vite.config.ts tsconfig.json components.json index.html",
    "dev:site": "vite --config vite.site.config.ts --host 127.0.0.1",
    "build:site": "tsc --noEmit -p tsconfig.site.json && vite build --config vite.site.config.ts && node site-build.mjs"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/api-logs": "0.223.0",
    "@opentelemetry/exporter-logs-otlp-http": "0.223.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.223.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-logs": "0.223.0",
    "@opentelemetry/sdk-metrics": "2.12.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@opentelemetry/sdk-trace-web": "2.12.0",
    "@rrweb/record": "2.1.7",
    "@rrweb/replay": "2.1.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.61.0",
    "posthog-js": "^1.438.13",
    "radix-ui": "^1.8.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "10.1.0",
    "rehype-slug": "6.0.0",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "^3.5.0",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.4",
    "axe-core": "4.14.0",
    "esbuild": "0.28.2",
    "jsdom": "30.1.3",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.2.1",
    "typescript": "~7.0.2",
    "vite": "^8.3.4",
    "vitest": "^4.0.18"
  }
}
