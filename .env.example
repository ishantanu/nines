# Run python3 scripts/setup-local.py to generate a private .env file.
# These placeholders must be replaced when configuring manually.
API_TOKEN=replace-with-a-random-token-of-at-least-24-characters
# Database password for both Compose configurations. This is NOT the web login.
POSTGRES_PASSWORD=replace-with-a-random-url-safe-password
# Web password for persistent compose.yaml only (username: admin).
NINES_BOOTSTRAP_PASSWORD=replace-with-a-random-password-of-at-least-12-bytes
NINES_PUBLIC_URL=http://127.0.0.1:8080
NINES_PORT=8080
# Compose supplies DATABASE_URL. For a native Go process set it explicitly.
# DATABASE_URL=postgres://platform:password@127.0.0.1:5432/platform?sslmode=disable
PROMETHEUS_URL=
PROMETHEUS_BEARER_TOKEN=
ALERT_WEBHOOK_URL=
VITE_OTEL_EXPORTER_OTLP_ENDPOINT=

# Optional server-owned multi-tenant config (native execution or mounted config).
TENANTS_FILE=
# Define each token/source-secret environment variable referenced by TENANTS_FILE.
# Legacy single-tenant Mimir mode; don't set PROMETHEUS_URL at the same time.
MIMIR_URL=
MIMIR_TENANT_ID=
MIMIR_BEARER_TOKEN=
MIMIR_USERNAME=
MIMIR_PASSWORD=

# Optional owner-managed source CRUD. Hosts are exact, administrator-approved DNS names.
NINES_SOURCE_HOSTS=
# Generate a private 32-byte key with: openssl rand -base64 32
# Back up this key separately; encrypted managed-source credentials require it after restore.
NINES_SOURCE_ENCRYPTION_KEY=
NINES_MANAGED_RULE_DIRECTORY=

# Web password for compose.playground.yaml only (username: admin).
# Default: admin. Set before the first startup to customize.
# NINES_PLAYGROUND_PASSWORD=choose-a-playground-password-of-at-least-12-bytes
# Existing database volumes retain account passwords; use Access control > Users to change them.

# Optional ./playground up --jev. Ordinary playgrounds need no model key.
# Prefer exporting JEV_API_KEY in your shell; never commit it or put it in YAML.
# JEV_API_KEY=your-private-typesafe-key
