# Native server: explicit OTLP/HTTP enablement, all three signals.
OTEL_SERVICE_NAME=nines-server
OTEL_RESOURCE_ATTRIBUTES=service.version=0.1.0,deployment.environment.name=development
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:54318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1
OTEL_METRIC_EXPORT_INTERVAL=5000
OTEL_BSP_SCHEDULE_DELAY=1000
OTEL_BLRP_SCHEDULE_DELAY=1000
# Browser: build-time, public ingestion endpoint, no private headers/credentials.
VITE_OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:54318
